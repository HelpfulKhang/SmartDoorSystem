    {
        "id": "389ae992aa8077c0",
        "type": "function",
        "z": "flow_v23_final",
        "name": "LỌC KẾT QUẢ",
        "func": "// Kiểm tra xem có câu trả lời hợp lệ không\nif (msg.payload && msg.payload.candidates && msg.payload.candidates.length > 0) {\n    // Thành công -> Lấy nội dung\n    var aiResponse = msg.payload.candidates[0].content.parts[0].text;\n    msg.payload = aiResponse;\n}\nelse if (msg.payload && msg.payload.error) {\n    // Trường hợp Google báo lỗi cụ thể (Sai Key, Hết hạn mức...)\n    var errCode = msg.payload.error.code;\n    var errMsg = msg.payload.error.message;\n    msg.payload = \"🔴 Lỗi Google (\" + errCode + \"): \" + errMsg;\n}\nelse {\n    // Trường hợp lỗi lạ khác\n    msg.payload = \"🔴 Lỗi lạ: \" + JSON.stringify(msg.payload);\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
