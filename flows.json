    {
        "id": "f_parse_log",
        "type": "function",
        "z": "flow_v23_final",
        "name": "Parse Log",
        "func": "var feeds = msg.payload.feeds;\nvar logs = [];\nif (feeds && feeds.length > 0) {\n    for (var i = feeds.length - 1; i >= 0; i--) {\n        var f = feeds[i];\n        var t = f.created_at.replace(\"T\", \" \").replace(\"Z\", \"\");\n        var status = \"Unknown\";\n        \n        if (f.field2 == \"1\") status = \"BẤM CHUÔNG\";\n        else if (f.field1 == \"1\") status = \"MỞ CỬA (OPEN)\";\n        else if (f.field1 == \"0\") status = \"ĐÓNG CỬA (CLOSED)\";\n        \n        logs.push({time: t, event: status});\n    }\n}\nmsg.payload = logs;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 640,
        "wires": [
            [
                "tbl_cloud"
            ]
        ]
    },
    {
        "id": "tbl_cloud",
        "type": "ui_template",
        "z": "flow_v23_final",
        "group": "grp_log",
        "name": "Cloud Table",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<style>\n    table { width: 100%; border-collapse: collapse; }\n    th { background: #333; color: white; padding: 5px; text-align: left; }\n    td { border-bottom: 1px solid #555; padding: 5px; }\n</style>\n<table>\n    <thead>\n        <tr><th>Thời gian</th><th>Sự kiện</th></tr>\n    </thead>\n    <tbody>\n        <tr ng-repeat=\"row in msg.payload\">\n            <td>{{row.time}}</td>\n            <td style=\"color: cyan\">{{row.event}}</td>\n        </tr>\n    </tbody>\n</table>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 750,
        "y": 640,
        "wires": [
            []
        ]
    },
    {
        "id": "ab390056fede31d3",
        "type": "function",
        "z": "flow_v23_final",
        "name": "TẠO PROMPT",
        "func": "// --- 1. CẤU HÌNH BẢO MẬT ---\n// Dán API Key của bạn vào đây (Chỉ mình bạn thấy khi mở code này)\nvar API_KEY = \"AIzaSyD_UM8c_gi1ojuGSTcWw1S76Olp6W582lg\"; // <--- THAY KEY CỦA BẠN VÀO ĐÂY\n\n// Chọn Model (2.0 Flash hoặc 1.5 Pro)\nvar MODEL = \"gemini-2.5-flash\";\n\n// --- 2. LẤY DỮ LIỆU ---\nvar status = flow.get('doorCurrentState') || \"Chưa rõ\";\nvar countOpen = flow.get('cOpen') || 0;\nvar countBell = flow.get('cBell') || 0;\nvar userQuestion = msg.payload; // Lấy câu hỏi từ nút Gửi\n\n// --- 3. TẠO NGỮ CẢNH (Context) ---\nvar contest = `Bạn là trợ lý ảo Smart Door.\nDữ liệu nhà hiện tại:\n- Cửa: ${status}\n- Số lần mở: ${countOpen}\n- Số lần bấm chuông: ${countBell}\nHãy trả lời ngắn gọn, thân thiện bằng tiếng Việt.`;\n\n// --- 4. ĐÓNG GÓI JSON ---\nmsg.payload = {\n    \"contents\": [{\n        \"parts\": [{\n            \"text\": contest + \"\\n\\nNgười dùng hỏi: \" + userQuestion\n        }]\n    }]\n};\n\n// --- 5. TẠO ĐƯỜNG LINK ĐỘNG (QUAN TRỌNG) ---\n// Node-RED sẽ dùng msg.url này để gửi đi thay vì dùng cấu hình tĩnh\nmsg.url = \"https://generativelanguage.googleapis.com/v1beta/models/\" + MODEL + \":generateContent?key=\" + API_KEY;\n\n// Header chuẩn\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 780,
        "wires": [
            [
                "dea597cd02e241d3"
            ]
        ]
    },
