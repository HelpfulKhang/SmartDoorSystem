    {
        "id": "func_process_status",
        "type": "function",
        "z": "flow_v23_final",
        "name": "Xử lý Cửa",
        "func": "var cOpen = flow.get('cOpen') || 0;\nvar cClose = flow.get('cClose') || 0;\n\nvar msgText = null;\nvar msgChart = null;\n\nif (msg.payload == \"OPEN\") {\n    cOpen++;\n    msgText = {payload: \"MỞ (OPEN)\"};\n    msgChart = {payload: 1};\n} \nelse if (msg.payload == \"CLOSED\") {\n    cClose++;\n    msgText = {payload: \"ĐÓNG (CLOSED)\"};\n    msgChart = {payload: 0};\n}\n\nflow.set('cOpen', cOpen);\nflow.set('cClose', cClose);\n\n// --- ĐOẠN CODE THÊM CHO CHATBOT ---\n// Lưu trạng thái vào biến 'doorCurrentState' để Chatbot đọc\nif (msg.payload == \"OPEN\") {\n    flow.set('doorCurrentState', \"Cửa đang MỞ\");\n} else {\n    // Vì logic của bạn là đóng cửa mới khóa được, nên Closed coi như an toàn\n    flow.set('doorCurrentState', \"Cửa đang ĐÓNG (AN TOÀN)\");\n}\n\n// Output 1: Text\n// Output 2: Chart\n// Output 3: Gauge Open\n// Output 4: Gauge Close\nreturn [\n    msgText, \n    msgChart, \n    {payload: cOpen}, \n    {payload: cClose}\n];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 80,
        "wires": [
            [
                "ui_text_status"
            ],
            [
                "ui_chart_door"
            ],
            [
                "g_open"
            ],
            [
                "g_close"
            ]
        ]
    },
    {
        "id": "func_process_bell",
        "type": "function",
        "z": "flow_v23_final",
        "name": "Xử lý Chuông",
        "func": "var cBell = flow.get('cBell') || 0;\n\nif (msg.payload == \"RING\") {\n    cBell++;\n}\n\nflow.set('cBell', cBell);\n\n// Output 1: Chart Trigger\n// Output 2: Gauge Bell\nreturn [\n    {payload: 1},\n    {payload: cBell}\n];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
